{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveMark",
  "version": "../package.json",
  "identifier": "com.livemark.app",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "copyright": "Live-updating Markdown viewer",
    "icon": [
      "../build/icon.icns",
      "../build/icon.png",
      "../build/icon.ico"
    ],
    "resources": {
      "../resources/bin/livemark": "bin/livemark"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/markdown",
        "contentTypes": ["com.livemark.markdown", "net.daringfireball.markdown"],
        "exportedType": {
          "identifier": "com.livemark.markdown",
          "conformsTo": ["public.plain-text", "public.text"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERERGMURBRjgyQUJDQzEKUldUQnZDcjQydkhkN1VtOW9ZYUtmaGM0MVgyVUxuSE9uenUzdm1OU3dKMjJrVnRwNjhrVVQzS1MK",
      "endpoints": [
        "https://github.com/rcoenen/LiveMark/releases/latest/download/latest.json"
      ]
    }
  }
}
