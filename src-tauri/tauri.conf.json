{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveMark",
  "version": "../package.json",
  "identifier": "com.livemark.app",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiveMark",
        "width": 900,
        "height": 700,
        "minWidth": 400,
        "minHeight": 300,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "Live-updating Markdown viewer for macOS",
    "icon": [
      "../build/icon.icns",
      "../build/icon.png"
    ],
    "resources": {
      "../resources/bin/livemark": "bin/livemark"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
