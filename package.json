{
  "name": "livemark",
  "version": "1.6.4",
  "description": "Live-updating Markdown viewer",
  "scripts": {
    "build:frontend": "node scripts/build-frontend.mjs",
    "build": "npm run build:frontend && cargo check --manifest-path src-tauri/Cargo.toml",
    "start": "tauri dev",
    "dev": "tauri dev",
    "test": "npm run build:frontend && npm run test:frontend && cargo test --manifest-path src-tauri/Cargo.toml",
    "dist": "sh scripts/package-release.sh",
    "tauri": "tauri",
    "test:frontend": "vitest run"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.27.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.9.0",
    "markdown-it": "^15.0.0",
    "turndown": "^7.2.2"
  }
}
