{
  "name": "livemark",
  "version": "1.1.0",
  "description": "Live-updating Markdown viewer for macOS",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && esbuild src/renderer/renderer.ts --bundle --outfile=dist/renderer/renderer.js --platform=browser --target=es2020 && cp src/renderer/styles.css dist/renderer/",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "watch": "tsc -w",
    "dist": "npm run build && electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.27.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.0.0"
  },
  "build": {
    "appId": "com.livemark.app",
    "productName": "LiveMark",
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      }
    ],
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "index.html",
      "package.json",
      "!node_modules/**/*",
      "node_modules/chokidar/**/*",
      "node_modules/anymatch/**/*",
      "node_modules/braces/**/*",
      "node_modules/fill-range/**/*",
      "node_modules/to-regex-range/**/*",
      "node_modules/is-number/**/*",
      "node_modules/glob-parent/**/*",
      "node_modules/is-glob/**/*",
      "node_modules/is-extglob/**/*",
      "node_modules/is-binary-path/**/*",
      "node_modules/binary-extensions/**/*",
      "node_modules/normalize-path/**/*",
      "node_modules/readdirp/**/*",
      "node_modules/picomatch/**/*"
    ]
  }
}
